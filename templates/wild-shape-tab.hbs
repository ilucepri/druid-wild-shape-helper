<section class="tab wsh-tab {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
    {{#with wildShape}}

    {{!-- Current state and main button --}}
    <header class="wsh-header">
        <div class="wsh-status">
            {{#if transformed}}
            <img src="{{ currentImg }}" alt="">
            <div>
                <span class="wsh-label">{{ localize "WILDSHAPEHELPER.CurrentForm" }}</span>
                <strong>{{ currentForm }}</strong>
            </div>
            {{else}}
            <div>
                <span class="wsh-label">{{ localize "WILDSHAPEHELPER.Status" }}</span>
                <strong>{{ localize "WILDSHAPEHELPER.NotTransformed" }}</strong>
            </div>
            {{/if}}
        </div>

        <div class="wsh-meta">
            {{#if uses}}
            <span class="wsh-pill" data-tooltip="WILDSHAPEHELPER.Uses">
                <i class="fas fa-paw" inert></i> {{ uses.value }} / {{ uses.max }}
            </span>
            {{/if}}
            {{#if maxCR}}
            <span class="wsh-pill" data-tooltip="WILDSHAPEHELPER.MaxCR">{{ localize "WILDSHAPEHELPER.CR" }} ≤ {{ maxCR }}</span>
            {{/if}}
            <span class="wsh-pill" data-tooltip="WILDSHAPEHELPER.Flying">
                <i class="fas fa-feather" inert></i>
                {{#if maxFlyCR}}{{ localize "WILDSHAPEHELPER.CR" }} ≤ {{ maxFlyCR }}{{else}}<i class="fas fa-ban" inert></i>{{/if}}
            </span>
            {{#if legacy}}
            <span class="wsh-pill" data-tooltip="WILDSHAPEHELPER.Swimming">
                <i class="fas fa-water" inert></i>
                {{#if maxSwimCR}}{{ localize "WILDSHAPEHELPER.CR" }} ≤ {{ maxSwimCR }}{{else}}<i class="fas fa-ban" inert></i>{{/if}}
            </span>
            <span class="wsh-pill" data-tooltip="WILDSHAPEHELPER.LegacyHint">2014</span>
            {{/if}}
        </div>

        {{#if owner}}
        {{#if transformed}}
        <button type="button" class="wsh-button wsh-revert" data-wsh-action="revert">
            <i class="fas fa-rotate-left" inert></i> {{ localize "WILDSHAPEHELPER.Revert" }}
        </button>
        {{else}}
        <button type="button" class="wsh-button" data-wsh-action="transform" {{#unless canUse}}disabled{{/unless}}>
            <i class="fas fa-paw" inert></i> {{ localize "WILDSHAPEHELPER.WildShape" }}
        </button>
        {{/if}}
        {{/if}}
    </header>

    {{!-- Known forms (2024) or favorite forms (2014) --}}
    <h3 class="wsh-title">
        <span>
            {{#if legacy}}{{ localize "WILDSHAPEHELPER.Favorites" }}{{else}}{{ localize "WILDSHAPEHELPER.KnownForms" }}{{/if}}
            <span class="wsh-count">{{ forms.length }}{{#if maxKnown}} / {{ maxKnown }}{{/if}}</span>
        </span>
        {{#if owner}}
        <button type="button" class="wsh-manage" data-wsh-action="manage">
            <i class="fas fa-list-check" inert></i>
            {{#if legacy}}{{ localize "WILDSHAPEHELPER.ManageFavorites" }}{{else}}{{ localize "WILDSHAPEHELPER.ManageForms" }}{{/if}}
        </button>
        {{/if}}
    </h3>
    <ul class="wsh-forms">
        {{#each forms}}
        <li class="wsh-form {{#unless allowed}}wsh-locked{{/unless}} {{#if favorite}}wsh-favorite{{/if}}" data-uuid="{{ uuid }}">
            {{!-- The whole card opens the creature's sheet --}}
            <button type="button" class="unbutton wsh-card" data-wsh-action="open"
                    {{#unless allowed}}data-tooltip="WILDSHAPEHELPER.Locked"{{/unless}}>
                <img src="{{ img }}" alt="">
                <span class="wsh-form-info">
                    <span class="wsh-form-name">{{ name }}</span>
                    <span class="wsh-form-cr">
                        {{ localize "WILDSHAPEHELPER.CR" }} {{ crLabel }}
                        {{#if fly}}<i class="fas fa-feather" inert></i>{{/if}}
                        {{#if swim}}<i class="fas fa-water" inert></i>{{/if}}
                    </span>
                </span>
                {{#unless allowed}}<i class="fas fa-lock wsh-lock" inert></i>{{/unless}}
            </button>
            {{#if @root.wildShape.owner}}
            <span class="wsh-card-controls">
                {{#unless @root.wildShape.legacy}}
                <button type="button" class="unbutton wsh-card-control wsh-star" data-wsh-action="favorite"
                        data-tooltip="{{#if favorite}}WILDSHAPEHELPER.Unfavorite{{else}}WILDSHAPEHELPER.Favorite{{/if}}"
                        aria-label="{{ localize 'WILDSHAPEHELPER.Favorite' }}" aria-pressed="{{#if favorite}}true{{else}}false{{/if}}">
                    <i class="{{#if favorite}}fas{{else}}far{{/if}} fa-star" inert></i>
                </button>
                {{/unless}}
                <button type="button" class="unbutton wsh-card-control wsh-remove" data-wsh-action="remove"
                        data-tooltip="WILDSHAPEHELPER.Remove" aria-label="{{ localize 'WILDSHAPEHELPER.Remove' }}">
                    <i class="fas fa-xmark" inert></i>
                </button>
            </span>
            {{/if}}
        </li>
        {{else}}
        <li class="wsh-empty">
            {{#if @root.wildShape.legacy}}{{ localize "WILDSHAPEHELPER.NoFavorites" }}{{else}}{{ localize "WILDSHAPEHELPER.NoForms" }}{{/if}}
        </li>
        {{/each}}
    </ul>
    {{#if owner}}
    <p class="wsh-hint">{{ localize "WILDSHAPEHELPER.DropHint" }}</p>
    {{/if}}

    {{/with}}
</section>
